# qqbot environment file.
#
# Copy to .env (beside this file, at the repo root) and set the values.
# Read at startup, before the WebUI accepts requests, so the panel is never
# briefly open to whoever reaches it first. The process environment wins over
# this file, so a container or systemd unit can override it without editing it.
# (A .env in the data directory is also accepted, as a fallback.)

# ---- 面板管理账号 (WebUI admin credential) ----
#
# Leave QQBOT_ADMIN_PASSWORD unset to keep using the WebUI's first-run setup
# form instead.
#
# The value here is authoritative: change the password and restart to reset it,
# which is the recovery path if it is ever lost.

# Admin account name. Defaults to "admin".
QQBOT_ADMIN_USERNAME=admin

# Admin password, minimum 8 characters. A blank value is ignored (it does NOT
# clear the password), so an empty line in a provisioning template is harmless.
QQBOT_ADMIN_PASSWORD=

# ---- 面板监听端口 (WebUI listen address) ----
#
# Either a bare port (4096) or a full address (:4096, 127.0.0.1:4096).
# Precedence: an explicit -addr flag > QQBOT_PORT here > the built-in default.
# Leave it unset to use the -addr flag's default (:4096).
#
# With docker compose this is the PUBLISHED host port; the container always
# listens on 4096 internally.
QQBOT_PORT=4096

# ---- 容器时区 (container timezone) ----
#
# Used by docker compose only; the panel's own day boundary is the "时区" setting
# in 监测设置. Keep the two consistent or the logs and the panel will disagree
# about what day it is.
TZ=Asia/Shanghai

# ---- 无需配置的两项 (nothing to configure for these) ----
#
# new-api 的登录会话与设备指纹都由服务自己管理，没有环境变量：
#   - 会话（刷新令牌）按「网关地址 + 账号 + 密码」存在数据库里，重启直接复用；
#   - 指纹由首次使用时生成并持久化的独立密钥 newapi.fingerprint_secret 派生，
#     与面板会话签名密钥分离；随 User-Agent 发出，让会话列表里这一条可辨认。
# 两者都在数据卷里，所以保留卷 = 重启后不重新登录 new-api。

# Optional: read the credential and port from a different file.
# QQBOT_ENV_FILE=/etc/qqbot.env
