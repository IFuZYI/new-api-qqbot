# ---- build output ----
/bin/
/qqbot
*.exe

# ---- runtime state ----
# The SQLite database and config.yaml live here. config.yaml stores the new-api
# password and the NapCat tokens in clear, so this directory must never be
# committed. *.tgz covers the backup tarball the README's docker command makes.
/data/
*.db
*.db-shm
*.db-wal
*.tgz

# ---- frontend ----
/web/node_modules/
/web/dist/
/web/tsconfig.tsbuildinfo

# ---- secrets ----
# The panel admin credential lives here; .env.example is the committed template.
.env
.env.*
!.env.example

# ---- upstream reference checkouts ----
# NapCatQQ and new-api are read as documentation for the protocols this service
# drives. They are not part of the build and are refreshed from upstream, so a
# local change here is never ours to keep.
/reference/

# ---- scratch ----
/tmp/

# ---- editor / OS noise ----
.vscode/
.idea/
.DS_Store
*.swp
